# Lead Automation Environment Variables
# Copy this file to .env.automation and fill in your actual values
# DO NOT commit .env.automation to git (it's in .gitignore)

# Email Provider Configuration
EMAIL_PROVIDER=brevo
BREVO_API_KEY=YOUR_BREVO_API_KEY_HERE
BREVO_FROM_EMAIL=your-email@fieldsprout.io
BREVO_FROM_NAME=Your Name from FieldSprout

# SerpAPI for web scraping
SERPAPI_API_KEY=YOUR_SERPAPI_KEY_HERE

# Database Connection
# Format: mysql+pymysql://username:password@host/database?charset=utf8mb4
# Note: URL-encode special characters in password (@=%40, ?=%3F, !=%21)
SQLALCHEMY_DATABASE_URI=mysql+pymysql://username:password@localhost/database?charset=utf8mb4

# Optional: Apollo.io for lead enrichment
# APOLLO_API_KEY=your_apollo_api_key_here

# Optional: OpenAI for AI features
# OPENAI_API_KEY=your_openai_api_key_here
