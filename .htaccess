# LiteSpeed / Passenger configuration for FieldSprout (Flask / Python)
# -----------------------------------------------------------------------
# WordPress lives in /blog/ — everything else is handled by Passenger (Python).
# -----------------------------------------------------------------------

# ---- Passenger (Python WSGI) -------------------------------------------
PassengerEnabled On
PassengerAppRoot /home/fieljtgr/flaskapp/flaskapp
PassengerBaseURI /
PassengerPython /home/fieljtgr/virtualenv/flaskapp/3.9/bin/python3
PassengerStartupFile passenger_wsgi.py

# ---- LSAPI worker tuning -----------------------------------------------
SetEnv LSAPI_CHILDREN 20
SetEnv LSAPI_MAX_PROCESS_TIME 300
SetEnv LSAPI_MAX_IDLE 120
SetEnv LSAPI_MAX_REQUESTS 1000

# ---- Routing -----------------------------------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On

    # 1. /blog/* → WordPress/PHP — stop here, serve from filesystem
    RewriteCond %{REQUEST_URI} ^/blog(/|$)
    RewriteRule ^ - [L]

    # 2. Block PHP execution outside /blog/ (security: stray PHP uploads)
    RewriteCond %{REQUEST_URI} !^/blog/
    RewriteRule \.php$ - [F,L]

    # 3. Serve real static files directly (CSS, JS, images, fonts)
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # 4. Everything else (including /) → Passenger (Python/Flask)
    #    No -d rule here: the root / must NOT be short-circuited to the
    #    filesystem — Passenger must handle it so Flask can serve home.html.
</IfModule>

# ---- Disable directory listing -----------------------------------------
Options -Indexes
