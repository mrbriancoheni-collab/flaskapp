# -----------------------------------------------------------------------
# FieldSprout — LiteSpeed / cPanel Gunicorn proxy config
# -----------------------------------------------------------------------
# The app runs as a Gunicorn daemon on 127.0.0.1:8000.
# LiteSpeed proxies all dynamic requests there via cPanel's proxy rules.
# -----------------------------------------------------------------------

# ---- CRITICAL: prevent LiteSpeed from rewriting / to /index.php ------
# Without this, LiteSpeed's default DirectoryIndex converts every bare /
# request to /index.php before proxying, so Flask never sees PATH_INFO="/"
# and the homepage 404s.
DirectoryIndex disabled

# ---- Disable directory listing -----------------------------------------
Options -Indexes

# ---- Routing -----------------------------------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Block PHP execution (security hardening)
    RewriteRule \.php$ - [F,L]

    # Serve real static files directly (CSS, JS, images, fonts, robots.txt)
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # Proxy all dynamic requests to Gunicorn on port 8000
    RewriteRule ^(.*)$ http://127.0.0.1:8000$1 [P,L]
</IfModule>
