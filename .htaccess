# LiteSpeed / cPanel Python App (LSAPI / Passenger) configuration
# -----------------------------------------------------------------------
# This app runs via cPanel's Python App Manager (LiteSpeed LSAPI).
# LiteSpeed invokes passenger_wsgi.py directly — NO Gunicorn proxy needed.
# The proxy-to-8000 rule has been removed because nothing listens on 8000
# and it caused all dynamic requests to return 404.
# -----------------------------------------------------------------------

# ---- LSAPI worker tuning -----------------------------------------------
SetEnv LSAPI_CHILDREN 20
SetEnv LSAPI_MAX_PROCESS_TIME 300
SetEnv LSAPI_MAX_IDLE 120
SetEnv LSAPI_MAX_REQUESTS 1000

# ---- Routing -----------------------------------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Block PHP execution (security)
    RewriteRule \.php$ - [F,L]

    # Serve real static files directly (CSS, JS, images, fonts, robots.txt)
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # All other requests go to the LSAPI/Passenger Python app (passenger_wsgi.py).
    # No proxy rule — LiteSpeed handles this via its Python App handler.
</IfModule>

# ---- Disable directory listing -----------------------------------------
Options -Indexes
