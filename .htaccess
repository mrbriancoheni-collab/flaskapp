# -----------------------------------------------------------------------
# FieldSprout — CloudLinux Python Selector / LiteSpeed LSAPI config
# -----------------------------------------------------------------------
# The app runs via CloudLinux Python Selector (LSAPI/Passenger WSGI).
# LiteSpeed invokes passenger_wsgi.py directly — no Gunicorn proxy needed.
# CageFS prevents LiteSpeed from reaching localhost ports anyway.
# -----------------------------------------------------------------------

# ---- CRITICAL: prevent LiteSpeed from rewriting / to /index.php ------
DirectoryIndex disabled

# ---- Disable directory listing -----------------------------------------
Options -Indexes

# ---- Routing -----------------------------------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Block direct PHP execution (security hardening)
    RewriteRule \.php$ - [F,L]

    # Serve real static files directly (CSS, JS, images, fonts, robots.txt)
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # All other requests pass through to CloudLinux LSAPI (passenger_wsgi.py)
    # Do NOT proxy to localhost:8000 — CageFS blocks cross-process connections
</IfModule>
