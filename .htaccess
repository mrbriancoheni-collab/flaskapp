# LiteSpeed Configuration for FieldSprout (Flask / Python via Gunicorn)
# -----------------------------------------------------------------------
# Gunicorn runs the Flask app as a standalone WSGI server on port 8000.
# LiteSpeed proxies all requests to it.  No Passenger/LSAPI directives.
# -----------------------------------------------------------------------

# ---- LSAPI worker tuning (kept for compatibility) ----------------------
SetEnv LSAPI_CHILDREN 20
SetEnv LSAPI_MAX_PROCESS_TIME 300
SetEnv LSAPI_MAX_IDLE 120
SetEnv LSAPI_MAX_REQUESTS 1000

# ---- Routing -----------------------------------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Block PHP execution (security)
    RewriteRule \.php$ - [F,L]

    # Serve real static files directly (CSS, JS, images, fonts)
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]
</IfModule>

# ---- Disable directory listing -----------------------------------------
Options -Indexes
