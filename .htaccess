# -----------------------------------------------------------------------
# FieldSprout — LiteSpeed / Gunicorn proxy config
# -----------------------------------------------------------------------
# The app runs as Gunicorn on 127.0.0.1:8000.
# LiteSpeed proxies all dynamic requests there via mod_rewrite.
# -----------------------------------------------------------------------

# ---- CRITICAL: prevent LiteSpeed from rewriting / to /index.php ------
DirectoryIndex disabled

# ---- Custom error pages (served directly as static files) --------------
ErrorDocument 400 /400.shtml
ErrorDocument 403 /400.shtml
ErrorDocument 404 /404.shtml
ErrorDocument 408 /400.shtml
ErrorDocument 500 /500.shtml
ErrorDocument 502 /500.shtml
ErrorDocument 503 /500.shtml
ErrorDocument 504 /500.shtml

# ---- Disable directory listing -----------------------------------------
Options -Indexes

# ---- Routing -----------------------------------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Block direct PHP execution (security hardening)
    RewriteRule \.php$ - [F,L]

    # Serve real static files directly (CSS, JS, images, fonts, robots.txt)
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # Proxy all dynamic requests to Gunicorn on port 8000
    RewriteRule ^(.*)$ http://127.0.0.1:8000$1 [P,L]
</IfModule>
