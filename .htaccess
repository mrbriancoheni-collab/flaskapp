# LiteSpeed Configuration for Flask App (Python)
# Increase LSAPI worker processes to handle concurrent requests

# LSAPI Configuration for Python Apps (use environment variables)
SetEnv LSAPI_CHILDREN 20
SetEnv LSAPI_MAX_PROCESS_TIME 300
SetEnv LSAPI_MAX_IDLE 120
SetEnv LSAPI_MAX_REQUESTS 1000

# Alternative: Module-based config (may not work for Python)
<IfModule Litespeed>
    php_value lsapi_children 20
    php_value lsapi_max_process_time 300
    php_value lsapi_max_idle 120
    php_value lsapi_max_requests 1000
</IfModule>
