# LiteSpeed / Passenger configuration for FieldSprout (Flask / Python)
# -----------------------------------------------------------------------
# WordPress lives in /blog/ — everything else is handled by Passenger (Python).
# -----------------------------------------------------------------------

# ---- Passenger (Python WSGI) -------------------------------------------
PassengerEnabled On
PassengerAppRoot /home/fieljtgr/flaskapp/flaskapp
PassengerBaseURI /
PassengerPython /home/fieljtgr/virtualenv/flaskapp/3.9/bin/python3
PassengerStartupFile passenger_wsgi.py

# ---- LSAPI worker tuning -----------------------------------------------
SetEnv LSAPI_CHILDREN 20
SetEnv LSAPI_MAX_PROCESS_TIME 300
SetEnv LSAPI_MAX_IDLE 120
SetEnv LSAPI_MAX_REQUESTS 1000

# ---- Routing -----------------------------------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Pass /blog/ requests directly to WordPress (filesystem)
    RewriteCond %{REQUEST_URI} ^/blog(/|$)
    RewriteRule ^ - [L]

    # Serve real static files directly (CSS, JS, images, fonts)
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # Serve real directories directly
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Route everything else through Passenger (Python) — never to index.php
    RewriteRule ^ - [L]
</IfModule>

# ---- Block PHP execution outside /blog/ --------------------------------
<FilesMatch "\.php$">
    Require all denied
</FilesMatch>
<IfModule mod_rewrite.c>
    RewriteCond %{REQUEST_URI} ^/blog/
    RewriteRule ^ - [L]
</IfModule>

# ---- Disable directory listing -----------------------------------------
Options -Indexes
