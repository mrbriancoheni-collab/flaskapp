# LiteSpeed / Passenger configuration for FieldSprout (Flask / Python)
# -----------------------------------------------------------------------
# All requests are handled by Passenger (Python/Flask).
# -----------------------------------------------------------------------

# ---- Passenger (Python WSGI) -------------------------------------------
PassengerEnabled On
PassengerAppRoot /home/fieljtgr/flaskapp/flaskapp
PassengerBaseURI /
PassengerPython /home/fieljtgr/virtualenv/flaskapp/3.9/bin/python3
PassengerStartupFile passenger_wsgi.py

# ---- LSAPI worker tuning -----------------------------------------------
SetEnv LSAPI_CHILDREN 20
SetEnv LSAPI_MAX_PROCESS_TIME 300
SetEnv LSAPI_MAX_IDLE 120
SetEnv LSAPI_MAX_REQUESTS 1000

# ---- Routing -----------------------------------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On

    # 1. Block PHP execution (security: stray PHP uploads)
    RewriteRule \.php$ - [F,L]

    # 2. Serve real static files directly (CSS, JS, images, fonts)
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # 3. Everything else (including / and /blog/*) → Passenger (Python/Flask)
    #    No -d rule here: the root / must NOT be short-circuited to the
    #    filesystem — Passenger must handle it so Flask can serve home.html.
    RewriteRule ^ - [L]
</IfModule>

# ---- Disable directory listing -----------------------------------------
Options -Indexes
